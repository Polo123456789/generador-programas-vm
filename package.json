{
  "name": "generador-programas-vm",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build": "nuxt build",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build",
    "dev": "nuxt dev",
    "generate": "nuxt generate && rsync -av --delete .output/public/ ./docs/ && bun scripts/normalizeGenerated.ts",
    "lint": "eslint .",
    "preview": "bun scripts/preview.ts",
    "test": "bun test",
    "typecheck": "nuxi typecheck",
    "verify:generated": "bun scripts/verifyGenerated.ts",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "nuxt": "^4.4.8",
    "vue": "^3.5.39",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.16.0",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^26.1.1",
    "eslint": "^9.39.5",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.3.7"
  }
}
